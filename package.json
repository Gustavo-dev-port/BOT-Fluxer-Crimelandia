{
  "name": "fluxer-bot",
  "version": "1.0.0",
  "description": "Fluxer BOT — duelos, temporadas, rankings, campeonatos e FluxCoins para o Fluxer (fluxer.app)",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gustavo-dev-port/BOT-Fluxer-Crimelandia.git"
  },
  "bugs": {
    "url": "https://github.com/Gustavo-dev-port/BOT-Fluxer-Crimelandia/issues"
  },
  "homepage": "https://github.com/Gustavo-dev-port/BOT-Fluxer-Crimelandia#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.4",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
