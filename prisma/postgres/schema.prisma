// ARQUIVO GERADO por scripts/sync-postgres-schema.mjs — não edite; edite prisma/schema.prisma.
// Fluxer BOT — esquema do banco (SQLite via Prisma)
// Status e formatos são armazenados como String; os valores válidos estão
// documentados em src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String   @id // ID do usuário no Discord
  username      String
  coins         Int      @default(0)
  equippedTitle String?
  eventCredits  Int      @default(0)
  createdAt     DateTime @default(now())

  stats        PlayerSeasonStats[]
  participants MatchParticipant[]
  teams        TeamMember[]
  entries      TournamentEntry[]
  transactions Transaction[]
  titles       PlayerTitle[]
  achievements PlayerAchievement[]
  tempRoles    TempRole[]
  tempNickname TempNickname?
  missions     PlayerMission[]
}

model Season {
  id         Int       @id @default(autoincrement())
  number     Int       @unique
  startedAt  DateTime  @default(now())
  endsAt     DateTime
  endedAt    DateTime?
  active     Boolean   @default(true)
  championId String?

  stats   PlayerSeasonStats[]
  matches Match[]
}

model PlayerSeasonStats {
  id         Int    @id @default(autoincrement())
  playerId   String
  seasonId   Int
  rating     Int    @default(1000)
  points     Int    @default(0)
  wins       Int    @default(0)
  losses     Int    @default(0)
  streak     Int    @default(0) // sequência atual de vitórias
  bestStreak Int    @default(0)

  player Player @relation(fields: [playerId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([playerId, seasonId])
}

model Game {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  captainId String
  createdAt DateTime @default(now())

  members TeamMember[]
  entries TournamentEntry[]
}

model TeamMember {
  id       Int    @id @default(autoincrement())
  teamId   Int
  playerId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([teamId, playerId])
}

model Match {
  id              Int       @id @default(autoincrement())
  seasonId        Int
  game            String
  status          String // PENDING | ACCEPTED | AWAITING_CONFIRMATION | DISPUTED | CONFIRMED | DECLINED | CANCELLED | EXPIRED | WAITING
  challengerId    String?
  team1Id         Int?
  team2Id         Int?
  reportedById    String?
  reportedSide    Int?
  winnerSide      Int?
  tournamentId    Int?
  round           Int?
  slot            Int?
  entry1Id        Int?
  entry2Id        Int?
  channelId       String?
  messageId       String?
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  reportedAt      DateTime?
  confirmedAt     DateTime?
  /// Duração da partida em segundos (informada no !resultado ou medida do aceite ao resultado)
  durationSeconds Int?

  season       Season             @relation(fields: [seasonId], references: [id])
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id])
  participants MatchParticipant[]

  @@index([status])
  @@index([tournamentId])
}

model MatchParticipant {
  id           Int    @id @default(autoincrement())
  matchId      Int
  playerId     String
  side         Int // 1 ou 2
  ratingBefore Int?
  ratingDelta  Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([playerId])
}

model Tournament {
  id            Int       @id @default(autoincrement())
  name          String
  game          String
  format        String // SINGLE_ELIM | ROUND_ROBIN
  teamSize      Int       @default(1)
  status        String    @default("REGISTRATION") // REGISTRATION | RUNNING | FINISHED | CANCELLED
  createdById   String
  isWeekly      Boolean   @default(false)
  channelId     String?
  messageId     String?
  winnerEntryId Int?
  closesAt      DateTime?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  entries TournamentEntry[]
  matches Match[]
}

model TournamentEntry {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  playerId     String?
  teamId       Int?
  seed         Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id])
  team       Team?      @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, playerId])
  @@unique([tournamentId, teamId])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  playerId  String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId])
}

model PlayerTitle {
  id         Int      @id @default(autoincrement())
  playerId   String
  title      String
  acquiredAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, title])
}

model PlayerAchievement {
  id         Int      @id @default(autoincrement())
  playerId   String
  key        String
  unlockedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, key])
}

/// Apelido especial comprado na loja; o anterior volta quando expira.
model TempNickname {
  playerId     String   @id
  nick         String
  previousNick String?
  expiresAt    DateTime

  player Player @relation(fields: [playerId], references: [id])
}

model TempRole {
  id         Int      @id @default(autoincrement())
  playerId   String
  roleId     String
  deleteRole Boolean  @default(false)
  expiresAt  DateTime

  player Player @relation(fields: [playerId], references: [id])
}

model Setting {
  key   String @id
  value String
}

/// Mensagem que espera uma reação (substitui os botões, que o Fluxer não tem).
/// kind: "challenge" (✅ aceitar / ❌ recusar) | "confirm" (✅ confirmar / ⚠️ contestar)
model ReactionPrompt {
  messageId String   @id
  channelId String
  kind      String
  matchId   Int
  createdAt DateTime @default(now())

  @@index([matchId])
}

/// Configuração por servidor (Fluxer guild). Canais e cargos usados pelo bot.
model GuildSettings {
  guildId             String   @id
  commandsChannelId   String?
  scoreboardChannelId String?
  matchesChannelId    String?
  eventChannelId      String?
  promoChannelId      String?
  freeGamesChannelId  String?
  musicChannelId      String?
  hallChannelId       String?
  promoRoleId         String?
  championRoleId      String?
  language            String   @default("pt-BR")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Promoção de jogo vista em alguma loja. O ID evita repostar a mesma oferta.
model Promotion {
  /// "<plataforma>:<id na loja>", ex.: "steam:1091500"
  id           String    @id
  title        String
  platform     String
  image        String?
  /// Preços em centavos
  oldPrice     Int
  currentPrice Int
  currency     String
  discount     Int
  expiresAt    DateTime?
  url          String
  active       Boolean   @default(true)
  /// Mensagem publicada no canal de promoções (para editar quando o preço muda)
  channelId    String?
  messageId    String?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, discount])
}

/// Jogo gratuito (Epic, giveaways da Steam/GOG, free weekends). O ID evita repostar.
model FreeGame {
  /// "<fonte>:<id>", ex.: "epic:abc123", "itad:16541"
  id          String    @id
  title       String
  platform    String
  /// "free" (grátis para resgatar) ou "free-weekend" (jogar grátis por tempo limitado)
  kind        String    @default("free")
  description String?
  image       String?
  url         String
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  channelId   String?
  messageId   String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, endsAt])
}

/// Missão do dia: 3 por dia, geradas à meia-noite (fuso TIMEZONE).
model DailyMission {
  id        Int      @id @default(autoincrement())
  /// Dia no fuso do servidor, "AAAA-MM-DD"
  date      String
  /// Tipo da missão (src/services/rules/missions.ts), ex.: "win_duels"
  kind      String
  target    Int
  reward    Int
  createdAt DateTime @default(now())

  players PlayerMission[]

  @@unique([date, kind])
  @@index([date])
}

/// Progresso de um jogador numa missão do dia.
model PlayerMission {
  id          Int       @id @default(autoincrement())
  missionId   Int
  playerId    String
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?

  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  player  Player       @relation(fields: [playerId], references: [id])

  @@unique([missionId, playerId])
  @@index([playerId])
}
