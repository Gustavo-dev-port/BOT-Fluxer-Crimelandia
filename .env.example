# Obrigatórias
# Token do bot (formato <application_id>.<secret>), gerado ao criar a aplicação no Fluxer
FLUXER_TOKEN=1553541281110556674.OsbRkEIYWDPDrfXukMq6zmSP56ZfrCURXbmhu00ETXM
# ID do servidor (guild) onde o bot vai funcionar
FLUXER_GUILD_ID=1553492482078015488

# Instância do Fluxer (os endpoints vêm de /.well-known/fluxer). Troque se usar uma instância própria.
FLUXER_INSTANCE=https://fluxer.app
# Prefixo dos comandos de texto (o Fluxer não tem slash commands)
COMMAND_PREFIX=!

# Banco SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:./fluxer.db"

# Fuso para agendamentos (evento semanal, etc.)
TIMEZONE=America/Sao_Paulo

# Ranking: "pontos" (vitória/derrota dão pontos) ou "elo"
RANKING_MODE=pontos
POINTS_WIN=3
POINTS_LOSS=1
ELO_K_FACTOR=32

# Temporadas
SEASON_DAYS=30
# 0 = reset total; 0.5 = mantém metade da distância até 1000
SEASON_CARRY_OVER=0
# Cargo exclusivo do campeão da temporada (opcional)
CHAMPION_ROLE_ID=

# Duelos
DUEL_EXPIRY_HOURS=24
# true = membros só usam comandos em #comandos
RESTRICT_COMMANDS_CHANNEL=false

# Evento semanal (cron: minuto hora dia mês dia-da-semana) — padrão sexta 20h
WEEKLY_EVENT_ENABLED=true
WEEKLY_EVENT_CRON="0 20 * * 5"
WEEKLY_EVENT_REGISTRATION_MINUTES=30
WEEKLY_EVENT_NAME="Night Fluxer"
WEEKLY_EVENT_GAME=Livre

# Loja: cargo cosmético VIP (opcional)
SHOP_VIP_ROLE_ID=
