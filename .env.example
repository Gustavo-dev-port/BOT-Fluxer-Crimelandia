# Obrigatórias
# Token do bot (formato <application_id>.<secret>), gerado ao criar a aplicação no Fluxer
FLUXER_TOKEN=
# ID do servidor (guild) onde o bot vai funcionar
FLUXER_GUILD_ID=

# Instância do Fluxer (os endpoints vêm de /.well-known/fluxer). Troque se usar uma instância própria.
FLUXER_INSTANCE=https://fluxer.app
# Prefixo dos comandos de texto (o Fluxer não tem slash commands)
COMMAND_PREFIX=!

# Banco de dados
# Desenvolvimento: SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:./fluxer.db"
# Produção (docker compose): PostgreSQL. O compose monta a DATABASE_URL a partir destes valores.
POSTGRES_USER=fluxer
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fluxer

# Logs (Winston): error | warn | info | debug. Arquivos em logs/error.log e logs/combined.log
LOG_LEVEL=info
# Console em "text" (colorido) ou "json" (uma linha por evento; bom para Docker e agregadores)
LOG_FORMAT=text

# Worker 24/7
# Porta do GET /health (0 = desligado). No Docker, o HEALTHCHECK usa esta porta.
HEALTH_PORT=3000
HEALTH_HOST=0.0.0.0
# Porta da VPS onde o compose publica o /health (só em 127.0.0.1)
HEALTH_HOST_PORT=3000
# Segundos sem Gateway até o /health responder "unhealthy" (reconexões rápidas não contam)
HEALTH_GATEWAY_GRACE_SECONDS=120
# Minutos sem Gateway ou sem banco até o worker se encerrar para ser reiniciado limpo (0 = nunca)
WORKER_WATCHDOG_MINUTES=10

# Fuso para agendamentos (evento semanal, etc.)
TIMEZONE=America/Sao_Paulo

# Ranking: "pontos" (vitória/derrota dão pontos) ou "elo"
RANKING_MODE=pontos
POINTS_WIN=3
POINTS_LOSS=1
ELO_K_FACTOR=32

# Temporadas: "monthly" (vira no dia 1º, no fuso TIMEZONE) ou "days" (dura SEASON_DAYS)
SEASON_MODE=monthly
SEASON_DAYS=30
# 0 = reset total; 0.5 = mantém metade da distância até 1000
SEASON_CARRY_OVER=0
# Cargo exclusivo do campeão da temporada (opcional; prefira !setup ou !config campeao-role)
CHAMPION_ROLE_ID=

# Duelos
DUEL_EXPIRY_HOURS=24
# true = membros só usam comandos em #comandos
RESTRICT_COMMANDS_CHANNEL=false

# Evento semanal (cron: minuto hora dia mês dia-da-semana) — padrão sexta 20h
WEEKLY_EVENT_ENABLED=true
WEEKLY_EVENT_CRON="0 20 * * 5"
WEEKLY_EVENT_REGISTRATION_MINUTES=30
WEEKLY_EVENT_NAME="Night Fluxer"
# Jogo usado quando não há jogos para a votação
WEEKLY_EVENT_GAME=Livre
# Night Fluxer: tamanho das equipes sorteadas (1 = sempre individual) e jogos na votação (até 5)
NIGHT_TEAM_SIZE=2
NIGHT_POLL_OPTIONS=4

# Loja: cargo cosmético VIP (opcional)
SHOP_VIP_ROLE_ID=

# ─── Promoções ───────────────────────────────────────────────
PROMO_ENABLED=true
# A cada 30 minutos
PROMO_CRON="*/30 * * * *"
# Ignora descontos menores que isso
PROMO_MIN_DISCOUNT=40
# A partir deste desconto, menciona o cargo configurado em !config promo-role
PROMO_MENTION_DISCOUNT=80
# No máximo N postagens por rodada (o resto sai nas próximas)
PROMO_MAX_POSTS_PER_RUN=10
# Lojas: steam, epic, gog, humble, itad (Nuuvem e Green Man Gaming via IsThereAnyDeal)
PROMO_SOURCES=steam,epic,gog,humble,itad
PROMO_COUNTRY=BR
PROMO_CURRENCY=BRL
# Chave gratuita da IsThereAnyDeal (https://isthereanydeal.com/apps/my/). Sem ela, Nuuvem e GMG ficam de fora.
ITAD_API_KEY=
# Lojas buscadas pela IsThereAnyDeal (nomes como a ITAD usa)
ITAD_SHOPS=Nuuvem,GreenManGaming
# Dias sem aparecer nas lojas até uma promoção ser considerada encerrada
PROMO_STALE_DAYS=3

# ─── Jogos grátis ────────────────────────────────────────────
FREE_GAMES_ENABLED=true
# A cada 1 hora
FREE_GAMES_CRON="0 * * * *"
FREE_GAMES_MAX_POSTS_PER_RUN=10
# epic (jogos grátis da semana) e itad (giveaways da Steam/GOG; usa a mesma ITAD_API_KEY)
FREE_GAMES_SOURCES=epic,itad
# Lojas dos giveaways da IsThereAnyDeal (vazio = todas)
FREE_GAMES_ITAD_SHOPS=Steam,GOG
# Dias sem aparecer até um jogo grátis ser considerado encerrado
FREE_GAMES_STALE_DAYS=2

# ─── Música ──────────────────────────────────────────────────
MUSIC_ENABLED=true
# yt-dlp instalado no sistema (Windows: winget install yt-dlp · Linux/macOS: pip install -U yt-dlp)
YTDLP_PATH=yt-dlp
# ffmpeg: vazio = o do pacote npm @ffmpeg-installer/ffmpeg (já vem com o npm install)
FFMPEG_PATH=
# Volume inicial (0–150)
MUSIC_DEFAULT_VOLUME=80
# Minutos com a sala vazia (ou a fila acabada) até o bot sair
MUSIC_IDLE_MINUTES=5
# Opcional: app do Spotify (https://developer.spotify.com/dashboard) para tocar álbuns e playlists.
# Sem isso, só links de faixas do Spotify funcionam.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
